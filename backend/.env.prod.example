# Production Environment Configuration
APP_NAME="RelAI"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=relai
DB_USERNAME=postgres
DB_PASSWORD=relai123

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=relai_cache

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue Configuration
QUEUE_CONNECTION=database

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@relai.go.id

# PostgreSQL Configuration
POSTGRES_DB=relai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=relai123

# External Access Configuration
APP_PORT=80
NGINX_PORT=80
DB_PORT=5432
REDIS_PORT=6379

# CORS Configuration (adjust for your frontend domain)
SANCTUM_STATEFUL_DOMAINS=your-domain.com
SESSION_DOMAIN=your-domain.com

# SSL Configuration
FORCE_HTTPS=true

# Application URL (update with your domain)
APP_URL=https://your-domain.com