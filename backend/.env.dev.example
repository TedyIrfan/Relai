# Development Environment Configuration (Docker)
# Copy this file to .env and adjust as needed

APP_NAME="RelAI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database Configuration (Docker Compose Development)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=relai_backend
DB_USERNAME=sail
DB_PASSWORD=password

# PostgreSQL Container Configuration
POSTGRES_DB=relai_backend
POSTGRES_USER=sail
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache Configuration
CACHE_DRIVER=redis
CACHE_STORE=redis

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

# Queue Configuration
QUEUE_CONNECTION=database

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@relai.go.id
MAIL_FROM_NAME="${APP_NAME}"

# CORS Configuration (Development)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,localhost:5174
SESSION_DOMAIN=

# SSL Configuration (Development)
FORCE_HTTPS=false

# Swagger Configuration
L5_SWAGGER_CONST_HOST=http://localhost:8000
L5_SWAGGER_BASE_PATH=/api
